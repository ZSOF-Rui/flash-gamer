{
  "name": "flash-gamer",
  "version": "0.3.0",
  "private": true,
  "description": "Flash Gamer：Flash 小游戏离线馆，提取 SWF、本地运行、无网页广告",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "vendor": "node scripts/vendor-ruffle.js",
    "postinstall": "node scripts/vendor-ruffle.js",
    "dist": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "@ruffle-rs/ruffle": "0.8.0-nightly.2026.10.29"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.flashgamer.desktop",
    "productName": "Flash Gamer",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "vendor/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "FlashGamer-${version}-portable.exe"
    }
  }
}
